---
import BaseLayout from './BaseLayout.astro';
import SiteBrand from '../components/SiteBrand.astro';
import '../styles/workstation.css';
import '../styles/workstation-refinements.css';
import '../styles/workstation-layer-motion.css';
import '../styles/workstation-v25.css';
import '../styles/workstation-v26.css';
import '../styles/workstation-v28.css';
import '../styles/workstation-v33.css';
import '../styles/workstation-v34.css';
import '../styles/workstation-v35.css';
interface Props {
  title: string;
  active: 'schedule' | 'board' | 'activity' | 'systems';
}
const { title, active } = Astro.props;
---
<BaseLayout title={title} description="PROTORHEXIS reviewed public engineering summaries and undated future directions. No product release guarantees." noIndex={true}>
  <div class="ws-root">
    <header class="ws-header">
      <SiteBrand />
      <span class="ws-header-sep" aria-hidden="true"></span>
      <div class="ws-header-title"><span class="ws-signal"></span><span data-zh="公共开发路线图" data-en="PUBLIC DEVELOPMENT ROADMAP">公共开发路线图</span></div>
      <details class="ws-header-notice" data-mode="closed">
        <summary aria-label="公开数据范围说明 / Public data scope">
          <span class="ws-spot" aria-hidden="true"></span>
          <span data-zh="已审查公开内容" data-en="REVIEWED PUBLIC DATA">已审查公开内容</span>
          <span class="ws-header-notice-status">PARTIAL</span>
        </summary>
        <p data-zh="仅展示已审查的工程事实与非承诺性 Future 方向；未获批准的私有进展不会公开，公开审核也不等于产品发布资格。"
           data-en="Only reviewed facts and noncommittal future directions appear. Unapproved private updates remain hidden; disclosure approval is not a product release gate.">仅展示已审查的工程事实与非承诺性 Future 方向；未获批准的私有进展不会公开，公开审核也不等于产品发布资格。</p>
      </details>
      <div class="ws-header-right">
        <span class="ws-header-edition">WORKSTATION / V3.4</span>
        <div id="ws-header-search-slot" class="ws-header-search-slot" aria-label="Roadmap search"></div>
        <button class="ws-locale" type="button" data-lang-button aria-label="Switch language">EN</button>
      </div>
    </header>
    <main id="main" class="ws-main"><h1 class="visually-hidden">{title}</h1><slot /></main>
    <script>import '../scripts/roadmap-notice.ts';</script>
    <footer class="ws-footer"><span>© PROTORHEXIS · ENGINEERING SURFACE</span><span data-zh="已公开记录 · 不代表其他系统发布资格或未来交付承诺" data-en="PUBLIC RECORDS · NO CROSS-SYSTEM RELEASE CLAIM OR FUTURE COMMITMENT">界面样本 · 不代表发布资格或时间承诺</span><span class="ws-footer-state">PUBLIC SNAPSHOT / LIMITED COVERAGE</span></footer>
  </div>
</BaseLayout>
