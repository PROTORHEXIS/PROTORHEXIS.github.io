---
import '../styles/site.css';
interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}
const { title, description = 'PROTORHEXIS public engineering roadmap. Public milestones are published only after review.', noIndex = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0D0D0F" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <title>{title} · PROTORHEXIS</title>
  </head>
  <body data-page-title={title}>
    <a class="skip" href="#main">Skip to content / 跳到正文</a>
    <slot />
    <script>import '../scripts/locale.ts';</script>
  </body>
</html>
