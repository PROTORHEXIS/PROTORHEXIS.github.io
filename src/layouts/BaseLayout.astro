---
// Bundled self-hosted variable faces: Latin and Simplified Chinese; no system-font dependency.
import '@fontsource-variable/noto-sans/wght.css';
import '@fontsource-variable/noto-sans-sc/wght.css';
import '../styles/site.css';
import '../styles/site-loading.css';
import SiteLoadingGate from '../components/SiteLoadingGate.astro';
interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}
const { title, description = 'PROTORHEXIS public engineering roadmap. Public milestones are published only after review.', noIndex = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Cover first paint before the shared transition bundle is ready.
      // This limited watchdog preserves page access if client JS fails.
      document.documentElement.classList.add('site-gate-boot');
      window.setTimeout(() => {
        if (!document.documentElement.classList.contains('site-gate-boot')) return;
        const gate = document.getElementById('site-loading-gate');
        if (gate) { gate.dataset.state = 'idle'; gate.setAttribute('aria-hidden', 'true'); }
        document.documentElement.classList.remove('site-gate-boot', 'site-gate-busy');
      }, 11000);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0D0D0F" />

    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <title>{title} · PROTORHEXIS</title>
  </head>
  <body data-page-title={title}>
    <SiteLoadingGate />
    <a class="skip" href="#main">Skip to content / 跳到正文</a>
    <slot />
    <script>import '../scripts/locale.ts'; import '../scripts/site-loading.ts';</script>
  </body>
</html>
